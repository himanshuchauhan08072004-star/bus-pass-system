# Copy to backend/.env for local development. NEVER commit a real .env file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://transitflow:transitflow_dev@localhost:5432/transitflow

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The defaults below are insecure placeholders; production refuses to start with them.
SECRET_KEY=dev-only-insecure-key-change-me-please-0123456789
QR_SIGNING_KEY=dev-only-insecure-qr-key-change-me-0123456789

# Browser origins allowed for CORS (the Next.js app proxies /api, so this is mostly for tools)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false            # must be true in production (HTTPS)
ACCESS_TOKEN_MINUTES=30

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
TRUST_FORWARDED_FOR=false      # true only behind a trusted proxy / load balancer

PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS_IN_PRODUCTION=false
BOOKING_HOLD_MINUTES=15
OPERATOR_TIMEZONE=Asia/Kolkata
CURRENCY=INR
LOG_LEVEL=INFO

# Used only by `python seed.py` (demo data). If unset, random passwords are generated and printed once.
# SEED_ADMIN_PASSWORD=
# SEED_PASSENGER_PASSWORD=
